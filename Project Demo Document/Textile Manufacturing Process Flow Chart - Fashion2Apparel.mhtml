		<div class=3D"entry-content" itemprop=3D"text">
			<div class=3D"f0a563704b9a4ad93ce1721e45667a12" data-index=3D"1" style=
=3D"float: none; margin:10px 0 10px 0; text-align:center;">

<!-- Fashion -->
<ins class=3D"adsbygoogle" style=3D"display:block" data-ad-client=3D"ca-pub=
-7527879365655387" data-ad-slot=3D"7501605594" data-ad-format=3D"auto" data=
-full-width-responsive=3D"true" data-adsbygoogle-status=3D"done" data-ad-st=
